# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Marketing Integration
# Kit (formerly ConvertKit) - Get from https://app.kit.com/account_settings/advanced
KIT_API_KEY=your_kit_v4_api_key

# SendGrid - Get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_TEMPLATE_ID=your_sendgrid_template_id

# Resend - Get from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Analytics
# Microsoft Clarity - Get from https://clarity.microsoft.com/
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=your_clarity_project_id

# Google Analytics 4 - Get from https://analytics.google.com/
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga4_measurement_id

# Error Monitoring
# Sentry - Get from https://sentry.io/settings/projects/
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Vercel Configuration (auto-populated in production)
# Get these from Vercel dashboard or .vercel/project.json
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Development Environment
NODE_ENV=development